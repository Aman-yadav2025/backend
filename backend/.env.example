# --- Database (use a privileged/service-role connection; NOT anon) --------
DATABASE_URL=postgresql+asyncpg://postgres:PASSWORD@HOST:5432/postgres

# --- Clerk ------------------------------------------------------------------
CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_WEBHOOK_SECRET=
CLERK_SECRET_KEY=

# --- Razorpay ----------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Cloudflare R2 ------------------------------------------------------------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_PRESIGNED_URL_EXPIRY_SECONDS=900
R2_MAX_UPLOAD_BYTES=52428800

# --- Internal (placeholder gate for promo-code admin endpoints) -------------
INTERNAL_SERVICE_KEY=change-me-to-a-long-random-string

# --- Redis (used for distributed rate limiting across workers) ---------------
REDIS_URL=redis://localhost:6379

# --- App -----------------------------------------------------------------
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

